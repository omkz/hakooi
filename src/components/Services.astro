---
const services = [
    {
        title: "BESPOKE SHOPIFY STORES",
        desc: "Crafting highly-customized Shopify Liquid storefronts that communicate your brand's unique narrative with zero template limitations.",
        icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
    },
    {
        title: "HEADLESS COMMERCE",
        desc: "Engineering lightning-fast storefronts using modern stacks like Astro & React connected to Shopify's Storefront API for sub-second load times.",
        icon: "M13 10V3L4 14h7v7l9-11h-7z"
    },
    {
        title: "CUSTOM INTEGRATIONS",
        desc: "Developing custom Rails middleware, specialized subscription engines, advanced Stripe checkout, and automated inventory sync systems.",
        icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
    },
    {
        title: "CONVERSION OPTIMIZATION",
        desc: "Fine-tuning mobile UX, core web vitals, dynamic mini-carts, and checkout flows to directly scale your average transaction value.",
        icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
    }
];
---

<section id="services" class="py-24 px-6 bg-white/[0.02]">
    <div class="max-w-6xl mx-auto">
        <div class="mb-16">
            <h2 class="font-heading text-5xl md:text-6xl text-white mb-4">OUR SERVICES.</h2>
            <div class="h-1 w-20 bg-[#3341FF]"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
            {services.map(service => (
                <div class="group p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-[#3341FF]/50 transition-all duration-500 hover:-translate-y-2 flex flex-col h-full">
                    <div class="w-12 h-12 rounded-lg bg-[#3341FF]/10 flex items-center justify-center mb-6 group-hover:bg-[#3341FF] transition-colors duration-500">
                        <svg class="w-6 h-6 text-[#3341FF] group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}></path>
                        </svg>
                    </div>
                    <h3 class="font-heading text-2xl text-white mb-4 tracking-wider leading-tight">{service.title}</h3>
                    <p class="text-gray-400 font-paragraph leading-relaxed text-sm flex-grow">
                        {service.desc}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>
