---
const services = [
    {
        title: "WEB Applications",
        desc: "Building robust, scalable, and high-performance web applications using Ruby on Rails as our primary engine.",
        icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    },
    {
        title: "UI/UX DESIGN",
        desc: "Crafting intuitive digital experiences that balance aesthetics with functional excellence and user-centric logic.",
        icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
    },
    {
        title: "PRODUCT STRATEGY",
        desc: "Consulting on product roadmaps, technical architecture, and scaling strategies for growing digital businesses.",
        icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2",
    },
];
---

<section id="services" class="py-24 px-6 bg-white/[0.02]">
    <div class="max-w-6xl mx-auto">
        <div class="mb-16">
            <h2 class="font-heading text-5xl md:text-6xl text-white mb-4">
                WHAT WE DO.
            </h2>
            <div class="h-1 w-20 bg-[#3341FF]"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                services.map((service) => (
                    <div class="group p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-[#3341FF]/50 transition-all duration-500 hover:-translate-y-2">
                        <div class="w-12 h-12 rounded-lg bg-[#3341FF]/10 flex items-center justify-center mb-6 group-hover:bg-[#3341FF] transition-colors duration-500">
                            <svg
                                class="w-6 h-6 text-[#3341FF] group-hover:text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d={service.icon}
                                />
                            </svg>
                        </div>
                        <h3 class="font-heading text-2xl text-white mb-4 tracking-wider">
                            {service.title}
                        </h3>
                        <p class="text-gray-400 font-paragraph leading-relaxed text-sm">
                            {service.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
