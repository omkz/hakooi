---
import { Image } from 'astro:assets';
import jonImg from '../assets/images/jon.webp';
import alfianImg from '../assets/images/alfianjau.webp';

const team = [
    {
        name: "JON",
        role: "Product & AI Engineer",
        image: jonImg,
        bio: "Product engineer focused on commerce systems, custom software, and applied AI."
    },
    {
        name: "ALFIAN",
        role: "Product Designer",
        image: alfianImg,
        bio: "Product designer focused on product flows, interfaces, and visual systems."
    }
];
---

<section id="team" class="scroll-mt-24 sm:scroll-mt-32 py-16 sm:py-24 px-4 sm:px-6 border-t border-white/5">
    <div class="max-w-4xl mx-auto">
        <div class="mb-12 sm:mb-20 text-center">
            <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-white">THE PEOPLE.</h2>
        </div>

        <div class="flex flex-col gap-16 md:gap-24">
            {team.map((member) => (
                <div class="flex min-w-0 flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8 md:gap-12 group">
                    <div class="shrink-0 relative">
                        <div class="absolute -inset-1 bg-white/10 rounded-full blur opacity-0 group-hover:opacity-40 transition duration-500"></div>
                        <Image 
                            src={member.image} 
                            alt={member.name}
                            class="relative w-32 h-32 md:w-40 md:h-40 rounded-full object-cover grayscale shadow-2xl border border-white/10"
                        />
                    </div>
                    <div class="min-w-0 text-center md:text-left pt-2">
                        <h3 class="font-heading text-3xl md:text-4xl text-white tracking-wider mb-1">{member.name}</h3>
                        <h4 class="text-[#3341FF] font-bold text-xs uppercase tracking-[0.14em] sm:tracking-[0.2em] mb-4 break-words">{member.role}</h4>
                        <p class="text-gray-400 font-paragraph leading-relaxed max-w-lg">
                            {member.bio}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
