---
import NetworkBackground from './NetworkBackground.astro';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center px-6 pt-20 overflow-hidden bg-[#0a0a0a]">
    <!-- Jigsaw Style Background -->
    <NetworkBackground />
    
    <div class="max-w-6xl w-full relative z-10 parallax-content">
        <div class="flex flex-col items-center text-center">
            <span
                class="text-[#3341FF] font-bold tracking-[0.4em] text-sm mb-6 uppercase"
                data-aos="fade-down"
            >
                Ecommerce Growth Studio
            </span>
            <h1
                id="scramble-text"
                class="font-heading text-7xl md:text-9xl leading-[0.85] text-white mb-8 select-none uppercase tracking-tighter"
            >
                CRAFTING<br/>MODERN<br/>COMMERCE<span class="text-[#3341FF]">.</span>
            </h1>
            <p
                class="max-w-2xl text-gray-400 text-lg md:text-xl font-paragraph leading-relaxed mb-12"
                data-aos="fade-up"
                data-aos-delay="200"
            >
                Specializing in <span class="text-white font-bold">Shopify</span> & modern commerce systems. Bridging the gap between creative storytelling and high-converting technology.
            </p>

            <div class="flex flex-col md:flex-row gap-6" data-aos="fade-up" data-aos-delay="400">
                <a
                    href="#services"
                    class="magnetic-btn px-10 py-4 bg-[#3341FF] text-white font-bold rounded-full hover:scale-105 transition-all duration-300 shadow-[0_0_30px_rgba(51,65,255,0.2)]"
                >
                    <span class="btn-text">OUR SERVICES</span>
                </a>
                <a
                    href="#contact"
                    class="magnetic-btn px-10 py-4 bg-white/5 text-white font-bold rounded-full border border-white/10 hover:bg-white/10 transition-all duration-300"
                >
                    <span class="btn-text">GET IN TOUCH</span>
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    // --- TEXT SCRAMBLE EFFECT ---
    class TextScramble {
        el: HTMLElement;
        chars: string;
        queue: any[];
        frame: number;
        resolve: any;

        constructor(el: HTMLElement) {
            this.el = el;
            this.chars = '!<>-_\\/[]{}—=+*^?#________';
            this.update = this.update.bind(this);
            this.queue = [];
            this.frame = 0;
        }
        setText(newText: string) {
            const oldText = this.el.innerText;
            const length = Math.max(oldText.length, newText.length);
            const promise = new Promise((resolve) => this.resolve = resolve);
            this.queue = [];
            for (let i = 0; i < length; i++) {
                const from = oldText[i] || '';
                const to = newText[i] || '';
                const start = Math.floor(Math.random() * 40);
                const end = start + Math.floor(Math.random() * 40);
                this.queue.push({ from, to, start, end, char: '' });
            }
            cancelAnimationFrame(this.frame);
            this.frame = 0;
            this.update();
            return promise;
        }
        update() {
            let output = '';
            let complete = 0;
            for (let i = 0, n = this.queue.length; i < n; i++) {
                let { from, to, start, end, char } = this.queue[i];
                if (this.frame >= end) {
                    complete++;
                    output += to;
                } else if (this.frame >= start) {
                    if (!char || Math.random() < 0.28) {
                        char = this.randomChar();
                        this.queue[i].char = char;
                    }
                    output += `<span class="text-[#3341FF] opacity-50">${char}</span>`;
                } else {
                    output += from;
                }
            }
            this.el.innerHTML = output;
            if (complete === this.queue.length) {
                this.resolve();
            } else {
                this.frame++;
                requestAnimationFrame(this.update);
            }
        }
        randomChar() {
            return this.chars[Math.floor(Math.random() * this.chars.length)];
        }
    }

    const el = document.getElementById('scramble-text');
    if (el) {
        const fx = new TextScramble(el);
        fx.setText('CRAFTING\nMODERN\nCOMMERCE.');
    }

    // --- MAGNETIC BUTTONS ---
    const magneticBtns = document.querySelectorAll('.magnetic-btn');
    magneticBtns.forEach(btn => {
        btn.addEventListener('mousemove', (e: any) => {
            const rect = btn.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            const btnEl = btn as HTMLElement;
            btnEl.style.transform = `translate(${x * 0.3}px, ${y * 0.5}px)`;
            
            const text = btn.querySelector('.btn-text') as HTMLElement;
            if (text) text.style.transform = `translate(${x * 0.1}px, ${y * 0.2}px)`;
        });

        btn.addEventListener('mouseleave', () => {
            const btnEl = btn as HTMLElement;
            btnEl.style.transform = `translate(0px, 0px)`;
            const text = btn.querySelector('.btn-text') as HTMLElement;
            if (text) text.style.transform = `translate(0px, 0px)`;
        });
    });

    // --- HERO PARALLAX ---
    const hero = document.getElementById('hero');
    const content = document.querySelector('.parallax-content') as HTMLElement;
    
    if (hero && content) {
        hero.addEventListener('mousemove', (e) => {
            const x = (window.innerWidth / 2 - e.clientX) / 50;
            const y = (window.innerHeight / 2 - e.clientY) / 50;
            content.style.transform = `translate(${x}px, ${y}px)`;
        });
    }
</script>

<style>
    .magnetic-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .btn-text {
        display: block;
        transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }
    #scramble-text {
        white-space: pre-wrap;
    }
</style>
