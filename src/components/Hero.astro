---
import NetworkBackground from './NetworkBackground.astro';
---

<section id="hero" class="relative min-h-screen min-h-[100svh] flex items-center justify-center px-4 sm:px-6 pt-28 sm:pt-24 md:pt-20 overflow-hidden bg-[#0a0a0a]">
    <!-- Jigsaw Style Background -->
    <NetworkBackground />
    
    <div class="max-w-6xl w-full relative z-10 parallax-content">
        <div class="flex flex-col items-center text-center">
            <span
                class="max-w-full text-[#3341FF] font-bold tracking-[0.18em] sm:tracking-[0.4em] text-[10px] sm:text-sm leading-relaxed mb-5 sm:mb-6 uppercase"
                data-aos="fade-down"
            >
                PRODUCT ENGINEERING STUDIO
            </span>
            <h1
                id="scramble-text"
                class="max-w-full font-heading text-[clamp(3.25rem,16vw,4.5rem)] md:text-9xl leading-[0.88] md:leading-[0.85] text-white mb-6 sm:mb-8 select-none uppercase tracking-tighter"
            >
                WE BUILD<br/>DIGITAL<br/>PRODUCTS<span class="text-[#3341FF]">.</span>
            </h1>
            <p
                class="max-w-2xl text-gray-400 text-base sm:text-lg md:text-xl font-paragraph leading-relaxed mb-10 sm:mb-12"
                data-aos="fade-up"
                data-aos-delay="200"
            >
                We design and engineer <span class="text-white font-bold">Shopify</span> and commerce platforms, custom applications, SaaS products, and AI-powered software from idea to production.
            </p>

            <div class="flex w-full max-w-xs flex-col md:max-w-none md:w-auto md:flex-row gap-4 sm:gap-6" data-aos="fade-up" data-aos-delay="400">
                <a
                    href="#contact"
                    class="magnetic-btn w-full md:w-auto px-8 sm:px-10 py-4 bg-[#3341FF] text-white font-bold rounded-full hover:scale-105 transition-all duration-300 shadow-[0_0_30px_rgba(51,65,255,0.4)]"
                >
                    <span class="btn-text">GET IN TOUCH</span>
                </a>
                <a
                    href="#services"
                    class="magnetic-btn w-full md:w-auto px-8 sm:px-10 py-4 bg-transparent text-white/70 font-bold rounded-full border border-white/20 hover:text-white hover:border-white/40 transition-all duration-300"
                >
                    <span class="btn-text">OUR SERVICES</span>
                </a>
            </div>
        </div>
    </div>
</section>

<script>

    // --- MAGNETIC BUTTONS ---
    const magneticBtns = document.querySelectorAll('.magnetic-btn');
    magneticBtns.forEach(btn => {
        btn.addEventListener('mousemove', (e: any) => {
            const rect = btn.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            const btnEl = btn as HTMLElement;
            btnEl.style.transform = `translate(${x * 0.3}px, ${y * 0.5}px)`;
            
            const text = btn.querySelector('.btn-text') as HTMLElement;
            if (text) text.style.transform = `translate(${x * 0.1}px, ${y * 0.2}px)`;
        });

        btn.addEventListener('mouseleave', () => {
            const btnEl = btn as HTMLElement;
            btnEl.style.transform = `translate(0px, 0px)`;
            const text = btn.querySelector('.btn-text') as HTMLElement;
            if (text) text.style.transform = `translate(0px, 0px)`;
        });
    });

    // --- HERO PARALLAX ---
    const hero = document.getElementById('hero');
    const content = document.querySelector('.parallax-content') as HTMLElement;
    
    if (hero && content) {
        hero.addEventListener('mousemove', (e) => {
            const x = (window.innerWidth / 2 - e.clientX) / 50;
            const y = (window.innerHeight / 2 - e.clientY) / 50;
            content.style.transform = `translate(${x}px, ${y}px)`;
        });
    }
</script>

<style>
    .magnetic-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .btn-text {
        display: block;
        transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }
    #scramble-text {
        white-space: pre-wrap;
    }
</style>
