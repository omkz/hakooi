---

<section class="min-h-screen flex items-center justify-center px-6 pt-20">
    <div class="max-w-6xl w-full">
        <div class="flex flex-col items-center text-center">
            <span
                class="text-[#3341FF] font-bold tracking-[0.4em] text-sm mb-6 uppercase"
                data-aos="fade-down"
            >
                Creative Digital Studio
            </span>
            <h1
                class="font-heading text-7xl md:text-9xl leading-[0.85] text-white mb-8 select-none"
            >
                CRAFTING <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500"
                    >DIGITAL</span
                ><br />
                <span class="text-[#3341FF]">EXCELLENCE</span>
            </h1>
            <p
                class="max-w-2xl text-gray-400 text-lg md:text-xl font-paragraph leading-relaxed mb-12"
            >
                We are a boutique studio specializing in high-performance <span
                    class="text-white font-bold">Applications</span
                > . Bridging the gap between complex engineering and intuitive design.
            </p>

            <div class="flex flex-col md:flex-row gap-6">
                <a
                    href="#services"
                    class="px-10 py-4 bg-[#3341FF] text-white font-bold rounded-full hover:scale-105 transition-transform duration-300 shadow-lg shadow-blue-500/20"
                >
                    Our Services
                </a>
                <a
                    href="#contact"
                    class="px-10 py-4 bg-white/5 text-white font-bold rounded-full border border-white/10 hover:bg-white/10 transition-all duration-300"
                >
                    Get in touch
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    h1 {
        text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
</style>
