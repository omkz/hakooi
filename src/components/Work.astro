---
import { Image } from 'astro:assets';
import luminaImg from '../assets/images/lumina.webp';
import vortexImg from '../assets/images/vortex.webp';
import auraImg from '../assets/images/aura.webp';

const projects = [
    {
        title: "LUMINA D2C",
        category: "Headless Storefront",
        desc: "Ultra-fast headless shopping experience built with Astro and Shopify Storefront API.",
        image: luminaImg
    },
    {
        title: "VORTEX COMMERCE",
        category: "Custom Integration",
        desc: "Complex commerce middleware handling automated stock movement and custom Stripe checkout.",
        image: vortexImg
    },
    {
        title: "AURA FLAGSHIP",
        category: "Bespoke Experience",
        desc: "Highly interactive Shopify Liquid flagship store with immersive animations and layout design.",
        image: auraImg
    }
];
---

<section id="work" class="scroll-mt-24 sm:scroll-mt-32 py-16 sm:py-24 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
        <div class="mb-12 sm:mb-20 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 sm:gap-8">
            <div>
                <h2 class="font-heading text-4xl sm:text-5xl md:text-7xl text-white mb-4 leading-none">SELECTED<br/>WORK.</h2>
                <div class="h-1 w-20 bg-[#3341FF]"></div>
            </div>
            <p class="text-gray-400 font-paragraph max-w-sm mb-2">
                A selection of digital products, commerce experiences, and software systems we've designed and engineered.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {projects.map(project => (
                <div class="group relative aspect-[4/5] overflow-hidden rounded-3xl bg-white/[0.03] border border-white/10">
                    <!-- Optimized Project Image -->
                    <Image 
                        src={project.image} 
                        alt={project.title}
                        width={800}
                        height={1000}
                        class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-110 group-hover:opacity-100 transition-all duration-700"
                    />
                    
                    <!-- Content Overlay -->
                    <div class="absolute inset-0 p-6 sm:p-10 flex min-w-0 flex-col justify-end bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent">
                        <span class="text-[#3341FF] font-bold text-[10px] uppercase tracking-[0.2em] sm:tracking-[0.3em] mb-3 sm:mb-4 break-words">{project.category}</span>
                        <h3 class="font-heading text-3xl sm:text-4xl text-white mb-2 tracking-wide sm:tracking-wider break-words">{project.title}</h3>
                        <p class="text-gray-400 text-sm font-paragraph leading-relaxed opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 translate-y-0 md:translate-y-4 md:group-hover:translate-y-0 transition-transform">
                            {project.desc}
                        </p>
                        
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
