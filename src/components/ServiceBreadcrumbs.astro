---
interface Props {
	currentPage: string;
}

const { currentPage } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: new URL('/', siteUrl).href
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Services',
			item: new URL('/#services', siteUrl).href
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: currentPage,
			item: new URL(Astro.url.pathname, siteUrl).href
		}
	]
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
