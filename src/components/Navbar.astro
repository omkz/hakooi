---
---
<nav class="fixed top-0 left-0 w-full z-50 px-3 sm:px-6 py-3 sm:py-6 transition-all duration-300" id="navbar">
    <div class="relative z-50 max-w-7xl mx-auto flex justify-between items-center bg-white/[0.03] backdrop-blur-xl border border-white/10 px-4 sm:px-8 py-3 sm:py-4 rounded-full">
        <div class="flex items-center gap-2">
            <a href="/" class="font-heading text-2xl tracking-tighter text-white">HAKOOI<span class="text-[#3341FF]">.</span></a>
        </div>
        
        <div class="hidden md:flex items-center gap-10 text-xs font-bold tracking-[0.2em] uppercase">
            <a href="/#services" class="text-white/60 hover:text-white transition-colors">Services</a>
            <a href="/#work" class="text-white/60 hover:text-white transition-colors">Work</a>
            <a href="/#team" class="text-white/60 hover:text-white transition-colors">People</a>
            <a href="/#contact" class="px-6 py-2 bg-[#3341FF] text-white rounded-full hover:scale-105 transition-transform duration-300">Contact</a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button class="md:hidden text-white p-2" id="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 max-w-full overflow-x-clip bg-[#0a0a0a] z-40 translate-x-full transition-transform duration-500 md:hidden flex flex-col items-center justify-center gap-8 px-4 sm:px-6 text-center" aria-hidden="true" inert>
        <a href="/#services" class="mobile-link text-4xl font-heading text-white">SERVICES</a>
        <a href="/#work" class="mobile-link text-4xl font-heading text-white">WORK</a>
        <a href="/#team" class="mobile-link text-4xl font-heading text-white">PEOPLE</a>
        <a href="/#contact" class="mobile-link px-10 py-4 bg-[#3341FF] text-white font-bold rounded-full text-xl mt-4">CONTACT</a>
    </div>
</nav>

<script>
    const navbar = document.getElementById('navbar');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const menuIcon = document.getElementById('menu-icon');
    const desktopMediaQuery = window.matchMedia('(min-width: 768px)');

    const setMenuOpen = (open: boolean) => {
        mobileMenu?.classList.toggle('translate-x-0', open);
        mobileMenu?.classList.toggle('translate-x-full', !open);
        mobileMenu?.setAttribute('aria-hidden', String(!open));
        mobileMenu?.toggleAttribute('inert', !open);
        menuToggle?.setAttribute('aria-expanded', String(open));
        menuIcon?.setAttribute('d', open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16m-7 6h7');
        document.body.classList.toggle('mobile-menu-open', open);
    };

    // Scroll effect
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            navbar?.classList.add('sm:py-4');
            navbar?.classList.remove('sm:py-6');
        } else {
            navbar?.classList.add('sm:py-6');
            navbar?.classList.remove('sm:py-4');
        }
    });

    // Toggle Mobile Menu
    menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
    });

    // Close menu on link click
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            setMenuOpen(false);
        });
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
            setMenuOpen(false);
            menuToggle.focus();
        }
    });

    desktopMediaQuery.addEventListener('change', (event) => {
        if (event.matches) setMenuOpen(false);
    });
</script>

<style is:global>
    body.mobile-menu-open {
        overflow: hidden;
    }
</style>
