---
---
<div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Nebula Glows -->
    <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-[#3341FF]/30 rounded-full blur-[200px] animate-pulse"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] bg-indigo-600/20 rounded-full blur-[200px] animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-[20%] right-[10%] w-[40%] h-[40%] bg-blue-400/10 rounded-full blur-[180px] animate-pulse" style="animation-delay: 4s;"></div>
</div>

<canvas id="network-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-60"></canvas>

<script>
    const canvas = document.getElementById('network-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');

    let particles: Particle[] = [];
    let shootingStars: ShootingStar[] = [];
    let comets: Comet[] = [];
    let supernova: Supernova | null = null;
    
    const particleCount = 120;
    const connectionDistance = 170;
    const mouse = { x: 0, y: 0, radius: 250 };

    const colors = ['#3341FF', '#8B5CF6', '#EC4899', '#10B981', '#06B6D4', '#F59E0B', '#EF4444', '#D9F99D', '#F472B6', '#00FF95'];

    class Particle {
        x: number; y: number; vx: number; vy: number; size: number;
        constructor() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.vx = (Math.random() - 0.5) * 0.6;
            this.vy = (Math.random() - 0.5) * 0.6;
            this.size = Math.random() * 2.5 + 1;
        }
        update() {
            this.x += this.vx;
            this.y += this.vy;
            if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
            if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
            
            // Supernova shockwave
            if (supernova && supernova.active && supernova.phase === 'exploding') {
                const dx = this.x - supernova.x;
                const dy = this.y - supernova.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < supernova.radius) {
                    const force = (supernova.radius - dist) / supernova.radius;
                    this.x += dx * force * 0.1;
                    this.y += dy * force * 0.1;
                }
            }

            const dx = mouse.x - this.x;
            const dy = mouse.y - this.y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            if (distance < mouse.radius) {
                const force = (mouse.radius - distance) / mouse.radius;
                this.x -= dx * force * 0.03;
                this.y -= dy * force * 0.03;
            }
        }
        draw() {
            if (!ctx) return;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(51, 65, 255, 0.7)';
            ctx.fill();
        }
    }

    class ShootingStar {
        x: number; y: number; vx: number; vy: number; len: number; opacity: number;
        constructor() { this.reset(); }
        reset() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height * 0.5;
            this.vx = Math.random() * 4 + 2;
            this.vy = Math.random() * 4 + 2;
            this.len = Math.random() * 30 + 20;
            this.opacity = Math.random() * 0.5 + 0.2;
        }
        update() {
            this.x += this.vx;
            this.y += this.vy;
            if (this.x > canvas.width || this.y > canvas.height) this.reset();
        }
        draw() {
            if (!ctx) return;
            ctx.beginPath();
            ctx.strokeStyle = `rgba(255, 255, 255, ${this.opacity})`;
            ctx.lineWidth = 0.5;
            ctx.moveTo(this.x, this.y);
            ctx.lineTo(this.x - this.vx * 5, this.y - this.vy * 5);
            ctx.stroke();
        }
    }

    class Comet {
        x: number; y: number; vx: number; vy: number; len: number; opacity: number; active: boolean; color: string;
        constructor() { this.active = false; this.reset(); this.scheduleNext(); }
        reset() {
            this.x = Math.random() * (canvas.width * 0.3); this.y = -200;
            this.vx = Math.random() * 10 + 20; this.vy = Math.random() * 5 + 15;
            this.len = Math.random() * 400 + 300; this.opacity = 1; this.active = false;
            this.color = colors[Math.floor(Math.random() * colors.length)];
        }
        scheduleNext() {
            setTimeout(() => { this.active = true; }, Math.random() * 8000 + 4000);
        }
        update() {
            if (!this.active) return;
            this.x += this.vx; this.y += this.vy;
            if (this.x > canvas.width + this.len || this.y > canvas.height + this.len) {
                this.reset(); this.scheduleNext();
            }
        }
        draw() {
            if (!this.active || !ctx) return;
            ctx.beginPath();
            const grad = ctx.createLinearGradient(this.x, this.y, this.x - this.vx * 15, this.y - this.vy * 15);
            grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
            grad.addColorStop(0.2, this.color);
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            ctx.strokeStyle = grad; ctx.lineWidth = 4;
            ctx.moveTo(this.x, this.y); ctx.lineTo(this.x - this.vx * 15, this.y - this.vy * 15);
            ctx.stroke();
            ctx.beginPath(); ctx.arc(this.x, this.y, 4, 0, Math.PI * 2); ctx.fillStyle = '#fff';
            ctx.shadowBlur = 20; ctx.shadowColor = this.color; ctx.fill(); ctx.shadowBlur = 0;
        }
    }

    class Supernova {
        x: number; y: number; radius: number; maxRadius: number; opacity: number; active: boolean; phase: 'charging' | 'exploding' | 'fading';
        constructor() { this.active = false; this.reset(); this.scheduleNext(); }
        reset() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.radius = 0;
            this.maxRadius = Math.random() * 300 + 200;
            this.opacity = 0;
            this.active = false;
            this.phase = 'charging';
        }
        scheduleNext() {
            setTimeout(() => { this.active = true; }, Math.random() * 30000 + 30000); // 30-60s
        }
        update() {
            if (!this.active) return;
            if (this.phase === 'charging') {
                this.opacity += 0.01;
                this.radius += 0.5;
                if (this.opacity >= 1) this.phase = 'exploding';
            } else if (this.phase === 'exploding') {
                this.radius += 10;
                this.opacity -= 0.02;
                if (this.opacity <= 0) {
                    this.reset();
                    this.scheduleNext();
                }
            }
        }
        draw() {
            if (!this.active || !ctx) return;
            ctx.beginPath();
            const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
            grad.addColorStop(0, `rgba(255, 255, 255, ${this.opacity})`);
            grad.addColorStop(0.5, `rgba(51, 65, 255, ${this.opacity * 0.5})`);
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            ctx.fillStyle = grad;
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    function init() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        particles = []; shootingStars = []; comets = [];
        for (let i = 0; i < particleCount; i++) particles.push(new Particle());
        for (let i = 0; i < 5; i++) shootingStars.push(new ShootingStar());
        for (let i = 0; i < 5; i++) comets.push(new Comet());
        supernova = new Supernova();
    }

    function animate() {
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (supernova) { supernova.update(); supernova.draw(); }
        comets.forEach(c => { c.update(); c.draw(); });
        shootingStars.forEach(s => { s.update(); s.draw(); });
        particles.forEach((p, i) => {
            p.update(); p.draw();
            for (let j = i + 1; j < particles.length; j++) {
                const p2 = particles[j];
                const dx = p.x - p2.x; const dy = p.y - p2.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < connectionDistance) {
                    ctx.beginPath();
                    ctx.strokeStyle = `rgba(51, 65, 255, ${(1 - dist / connectionDistance) * 0.8})`;
                    ctx.lineWidth = 0.8;
                    ctx.moveTo(p.x, p.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
                }
            }
        });
        requestAnimationFrame(animate);
    }

    window.addEventListener('resize', init);
    window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
    init(); animate();
</script>
