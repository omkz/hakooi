---
---
<div class="absolute inset-0 overflow-hidden pointer-events-none bg-[#0a0a0a]">
    <!-- Deep Ambient Glows (CSS fallback for static depth) -->
    <div class="absolute top-[-20%] left-[-20%] w-[80%] h-[80%] bg-[#3341FF]/10 rounded-full blur-[160px]"></div>
    <div class="absolute bottom-[-20%] right-[-20%] w-[80%] h-[80%] bg-indigo-600/10 rounded-full blur-[160px]"></div>
</div>

<canvas id="liquid-silk-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-70"></canvas>

<script>
    const canvas = document.getElementById('liquid-silk-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');

    const getScale = () => window.innerWidth < 768 ? 0.5 : 1.0;
    
    let scale = getScale();
    let width = canvas.width = Math.floor(window.innerWidth * scale);
    let height = canvas.height = Math.floor(window.innerHeight * scale);

    const mouse = { x: width / 2, y: height / 2, tx: width / 2, ty: height / 2 };

    class SilkBlob {
        x: number;
        y: number;
        tx: number;
        ty: number;
        vx: number;
        vy: number;
        radius: number;
        baseRadius: number;
        color: string;
        colorStopMiddle: string;
        angle: number;
        angleSpeed: number;
        orbitRadius: number;
        speed: number;

        constructor(x: number, y: number, radius: number, color: string, speed: number) {
            this.x = x;
            this.y = y;
            this.tx = x;
            this.ty = y;
            this.vx = 0;
            this.vy = 0;
            this.baseRadius = radius;
            this.radius = radius;
            this.color = color;
            // Pre-calculate lower opacity stop once at init to save hot-path CPU string allocations!
            this.colorStopMiddle = color.replace('0.4', '0.12').replace('0.3', '0.08').replace('0.25', '0.06');
            this.angle = Math.random() * Math.PI * 2;
            this.angleSpeed = (Math.random() * 0.0015 + 0.0008) * (Math.random() > 0.5 ? 1 : -1);
            this.orbitRadius = Math.random() * 100 + 50;
            this.speed = speed;
        }

        update() {
            // Very slow organic orbit (drifting)
            this.angle += this.angleSpeed;
            this.tx = width / 2 + Math.cos(this.angle) * (width * 0.28) + Math.sin(this.angle * 0.5) * this.orbitRadius;
            this.ty = height / 2 + Math.sin(this.angle) * (height * 0.28) + Math.cos(this.angle * 0.5) * this.orbitRadius;

            // Gentle interaction with mouse (slowly floating away/towards)
            const dx = mouse.x - this.x;
            const dy = mouse.y - this.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            
            // Adjust interaction range depending on scaling
            const maxDist = 600 * scale;
            if (dist < maxDist) {
                const force = (maxDist - dist) / maxDist;
                // Gently push the blobs away from the cursor to create a liquid dispersion look
                this.vx -= (dx / dist) * force * 0.2;
                this.vy -= (dy / dist) * force * 0.2;
            }

            // High friction for majestic, damped movements
            this.vx *= 0.94;
            this.vy *= 0.94;

            this.x += this.vx + (this.tx - this.x) * this.speed;
            this.y += this.vy + (this.ty - this.y) * this.speed;

            // Pulsing radius for fluid breathing effect
            this.radius = this.baseRadius + Math.sin(this.angle * 1.5) * (50 * scale);
        }

        draw() {
            if (!ctx) return;

            // Render soft, luxurious radial gradient (using pre-calculated colors)
            const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
            grad.addColorStop(0, this.color);
            grad.addColorStop(0.4, this.colorStopMiddle);
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

            ctx.beginPath();
            ctx.fillStyle = grad;
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    const blobs: SilkBlob[] = [];

    function init() {
        scale = getScale();
        width = canvas.width = Math.floor(window.innerWidth * scale);
        height = canvas.height = Math.floor(window.innerHeight * scale);
        
        blobs.length = 0;

        // Custom premium colors with balanced opacity for elegant visibility over transparent canvas
        blobs.push(new SilkBlob(width * 0.25, height * 0.25, Math.min(width, height) * 0.55, 'rgba(51, 65, 255, 0.4)', 0.003)); // Electric Blue
        blobs.push(new SilkBlob(width * 0.75, height * 0.35, Math.min(width, height) * 0.65, 'rgba(99, 102, 241, 0.3)', 0.002)); // Indigo
        blobs.push(new SilkBlob(width * 0.35, height * 0.75, Math.min(width, height) * 0.48, 'rgba(139, 92, 246, 0.3)', 0.004)); // Violet
        blobs.push(new SilkBlob(width * 0.65, height * 0.65, Math.min(width, height) * 0.42, 'rgba(6, 182, 212, 0.25)', 0.003)); // Cyan
    }

    let animId: number | null = null;
    let isVisible = true;

    function animate() {
        if (!ctx) {
            animId = null;
            return;
        }

        // Clear canvas fully to clear transparent background for elegant overlay rendering
        ctx.clearRect(0, 0, width, height);

        // Smooth mouse easing
        mouse.x += (mouse.tx - mouse.x) * 0.05;
        mouse.y += (mouse.ty - mouse.y) * 0.05;

        // Overlay blending mode for glowing liquid overlay effect
        ctx.globalCompositeOperation = 'screen';

        blobs.forEach(b => {
            b.update();
            b.draw();
        });

        ctx.globalCompositeOperation = 'source-over';
        
        if (isVisible) {
            animId = requestAnimationFrame(animate);
        } else {
            animId = null;
        }
    }

    // Set up IntersectionObserver to only animate when the canvas is in the viewport!
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const wasVisible = isVisible;
            isVisible = entry.isIntersecting;
            
            if (isVisible && !wasVisible) {
                // Resume loop if it was paused
                if (!animId) {
                    animId = requestAnimationFrame(animate);
                }
            } else if (!isVisible && wasVisible) {
                // Pause loop when out of viewport
                if (animId) {
                    cancelAnimationFrame(animId);
                    animId = null;
                }
            }
        });
    }, { threshold: 0.01 });

    if (canvas) {
        observer.observe(canvas);
    }

    window.addEventListener('resize', () => {
        init();
        if (isVisible && !animId) {
            animId = requestAnimationFrame(animate);
        }
    });
    
    window.addEventListener('mousemove', (e) => {
        const sc = getScale();
        mouse.tx = e.clientX * sc;
        mouse.ty = e.clientY * sc;
    });

    window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
            const sc = getScale();
            mouse.tx = e.touches[0].clientX * sc;
            mouse.ty = e.touches[0].clientY * sc;
        }
    });

    init();
    animate();
</script>
