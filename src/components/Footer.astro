---
const year = new Date().getFullYear();
---

<footer id="contact" class="scroll-mt-24 sm:scroll-mt-32 py-16 sm:py-20 px-4 sm:px-6 border-t border-white/5 bg-[#0a0a0a]">
    <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 sm:gap-16 mb-16 sm:mb-20">
            <div>
                <h2 class="font-heading text-4xl sm:text-5xl md:text-7xl text-white mb-6 leading-none">LET'S SCALE<br/>YOUR STORE.</h2>
                <p class="text-gray-400 font-paragraph mb-8 max-w-sm">
                    Ready to build your flagship storefront or custom commerce systems? We're just one message away.
                </p>
                <div class="flex flex-col gap-4">
                    <a href="mailto:mail@hakooi.com" class="max-w-full break-words text-lg sm:text-xl md:text-2xl text-[#3341FF] font-bold hover:opacity-80 transition-all">
                        mail@hakooi.com
                    </a>
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors text-sm font-bold tracking-widest uppercase flex items-center gap-2">
                        <span>Book a Discovery Call →</span>
                    </a>
                </div>
            </div>
            
            <div class="flex flex-col justify-end md:items-end">
                <div class="flex flex-wrap justify-start md:justify-end gap-x-6 gap-y-4 mb-8 text-sm font-bold tracking-wider sm:tracking-widest uppercase">
                    <a href="https://instagram.com/hakooistudio" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#3341FF] transition-colors">Instagram</a>
                    <a href="https://www.linkedin.com/company/hakooi" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#3341FF] transition-colors">LinkedIn</a>
                    <a href="https://github.com/hakooi" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#3341FF] transition-colors">GitHub</a>
                </div>
                <p class="max-w-full text-left md:text-right text-gray-400 text-sm font-paragraph">
                    Based in Yogyakarta, Indonesia. Serving globally.
                </p>
            </div>
        </div>
        
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-10 sm:pt-12 border-t border-white/5 text-center md:text-left text-gray-400 text-[11px] sm:text-xs leading-relaxed tracking-wide sm:tracking-widest uppercase font-bold">
            <p class="max-w-full">&copy; {year} HAKOOI STUDIO. ALL RIGHTS RESERVED.</p>
            <p>MADE WITH PASSION BY HAKOOI.</p>
        </div>
    </div>
</footer>
