---
const techs = [
    { name: "Ruby on Rails", icon: "/svg/ruby-on-rails.svg", alt: "Ruby on Rails logo", title: "Ruby on Rails" },
    { name: "Next.js", icon: "/svg/nextdotjs.svg", alt: "Next.js logo", title: "Next.js" },
    { name: "React", icon: "/svg/react.svg", alt: "React logo", title: "React" },
    { name: "Python", icon: "/svg/python.svg", alt: "Python logo", title: "Python" },
    { name: "PostgreSQL", icon: "/svg/postgresql.svg", alt: "PostgreSQL logo", title: "PostgreSQL" },
    { name: "Docker", icon: "/svg/docker.svg", alt: "Docker logo", title: "Docker" },
    { name: "AWS", icon: "/svg/amazonwebservices.svg", alt: "Amazon Web Services logo", title: "Amazon Web Services (AWS)" },
    { name: "Shopify", icon: "/svg/shopify.svg", alt: "Shopify logo", title: "Shopify" }
];
---

<section id="tech" class="py-16 sm:py-24 px-4 sm:px-6 bg-white/[0.01]">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 sm:mb-16">
            <h2 class="font-heading text-3xl sm:text-4xl text-white mb-3 italic">ENGINEERING STACK.</h2>
            <p class="font-paragraph text-sm sm:text-base text-white/50">
                The technologies we use to build, ship, and scale products.
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 sm:gap-4">
            {techs.map(tech => (
                <div class="group min-w-0 h-32 sm:h-36 flex flex-col items-center justify-center gap-3 rounded-xl bg-white/[0.025] px-3 py-4 transition-all duration-300 ease-out hover:-translate-y-1 hover:bg-white/[0.05] hover:shadow-[0_8px_24px_rgba(0,210,255,0.10)]">
                    <div class="h-12 w-12 sm:h-14 sm:w-14 flex items-center justify-center">
                        <img
                            src={tech.icon}
                            alt={tech.alt}
                            title={tech.title}
                            class="max-h-full max-w-full object-contain grayscale opacity-55 transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
                        />
                    </div>
                    <p class="text-center font-paragraph text-xs font-semibold leading-tight text-white/60 transition-colors duration-300 group-hover:text-white/90">
                        {tech.name}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>
