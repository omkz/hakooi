---
const techs = [
    { name: "Ruby on Rails", icon: "/svg/ruby-on-rails.svg" },
    { name: "React", icon: "/svg/react.svg" },
    { name: "PostgreSQL", icon: "/svg/postgresql.svg" },
    { name: "Golang", icon: "/svg/golang.svg" },
    { name: "Rust", icon: "/svg/rust.svg" },
    { name: "Shopify", icon: "/svg/shopify.svg" },
    { name: "Stripe", icon: "/svg/stripe.svg" },
    { name: "Tailwind", icon: "/svg/tailwindcss-icon.svg" }
];
---

<section id="tech" class="py-16 sm:py-24 px-4 sm:px-6 bg-white/[0.01]">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 sm:mb-16">
            <p class="font-heading text-3xl sm:text-4xl text-white mb-4 italic">ENGINEERING STACK.</p>
        </div>

        <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12 md:gap-20 opacity-40 grayscale hover:opacity-100 transition-all duration-700">
            {techs.map(tech => (
                <div class="w-12 h-12 md:w-16 md:h-16 flex items-center justify-center grayscale hover:grayscale-0 hover:scale-110 transition-all duration-300">
                    <img src={tech.icon} alt={tech.name} class="max-h-full max-w-full object-contain" title={tech.name} />
                </div>
            ))}
        </div>
    </div>
</section>
