---
const steps = [
    {
        number: "01",
        title: "DISCOVERY",
        desc: "We deep-dive into your vision, market dynamics, and technical constraints to build a solid strategic foundation."
    },
    {
        number: "02",
        title: "ARCHITECTURE",
        desc: "Crafting the technical blueprint and user experience flows designed for maximum efficiency and scalability."
    },
    {
        number: "03",
        title: "ENGINEERING",
        desc: "High-precision development phase where we manifest the product using modern, robust technologies."
    },
    {
        number: "04",
        title: "EVOLUTION",
        desc: "Beyond launch, we continuously optimize and scale the product to adapt to real-world feedback and growth."
    }
];
---

<section id="process" class="py-24 px-6 bg-white/[0.01]">
    <div class="max-w-6xl mx-auto">
        <div class="mb-20">
            <h2 class="font-heading text-5xl md:text-6xl text-white mb-4">THE PROCESS.</h2>
            <div class="h-1 w-20 bg-[#3341FF]"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
            {steps.map((step, index) => (
                <div class="relative" data-aos="fade-up" data-aos-delay={index * 100}>
                    <span class="font-heading text-6xl md:text-8xl text-white/5 absolute -top-8 -left-4 select-none italic">
                        {step.number}
                    </span>
                    <div class="relative z-10">
                        <h3 class="font-heading text-2xl text-white mb-4 tracking-widest flex items-center gap-4">
                            <span class="w-2 h-2 bg-[#3341FF] rounded-full"></span>
                            {step.title}
                        </h3>
                        <p class="text-gray-400 font-paragraph text-sm leading-relaxed">
                            {step.desc}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
