---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ServiceBreadcrumbs from '../../components/ServiceBreadcrumbs.astro';

// SEO details
const title = "Custom Software Development | Hakooi";
const desc = "Custom software development for SaaS products, internal tools, customer portals, and business applications built around real operational needs.";

const solutions = [
    {
        title: "SaaS Product Development",
        desc: "We design SaaS product architecture around user roles, product workflows, APIs, and billing requirements. Multi-tenant architecture and subscriptions are implemented when the product requires them.",
        features: ["Multi-tenant architecture", "Authentication & permissions", "Subscription billing", "Product APIs"]
    },
    {
        title: "Internal Tools & Operations",
        desc: "We build internal dashboards, admin systems, workflow tools, inventory and operations software, and import/export utilities around the way teams work.",
        features: ["Custom operational workflows", "Admin dashboards", "Data import & export", "Audit trails"]
    },
    {
        title: "Customer Portals",
        desc: "We create authenticated customer areas for account management, billing history, documents and downloads, reporting, and status views.",
        features: ["Account management", "Reporting dashboards", "Billing & documents", "Notifications"]
    },
    {
        title: "APIs & Integrations",
        desc: "We build backend APIs and integrations with third-party systems, using webhooks, asynchronous jobs, and external services where the workflow requires them.",
        features: ["REST / GraphQL APIs", "Webhooks & background jobs", "Third-party integrations", "CI/CD & deployment"]
    }
];

const faqItems = [
    {
        q: "What technologies do you use for building custom SaaS and business applications?",
        a: "We choose technologies based on product requirements, team constraints, expected scale, and long-term maintenance. Depending on the application, that may include Ruby on Rails, React or Next.js, TypeScript, Go, PostgreSQL, Redis, and supporting cloud services."
    },
    {
        q: "How do you handle application security and sensitive customer data?",
        a: "We design security controls around each application's risks and data. Practical measures can include least-privilege access, secure authentication and authorization, appropriately hashed passwords, encrypted transport, dependency management, and audit logging where required. The exact implementation depends on the product and its operating environment."
    },
    {
        q: "Can you build complex, custom subscription billing systems?",
        a: "We can implement subscription and usage-based billing with Stripe when the product requires it. Depending on the billing model, this can include recurring subscriptions, usage-based pricing, webhooks, and invoicing. Scope depends on the product, markets, and operational requirements."
    },
    {
        q: "Do you offer post-launch support and software maintenance?",
        a: "Yes. We can provide ongoing maintenance, monitoring, dependency updates, bug fixes, and incremental product development after launch."
    }
];

// JSON-LD Schema for SEO rich snippets
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
        }
    }))
};
---

<Layout title={title} description={desc}>
    <!-- FAQ Schema Injection -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <ServiceBreadcrumbs currentPage="Custom Applications Development" />

    <Navbar />

    <main class="relative overflow-hidden pt-28">
        <!-- Grid/Dot Background -->
        <div class="fixed inset-0 z-0 pointer-events-none opacity-20">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
            <div class="absolute top-0 left-0 w-full h-[500px] bg-gradient-to-b from-[#3341FF]/20 to-transparent blur-[120px]"></div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
            
            <!-- HERO SECTION -->
            <section class="py-16 sm:py-20 md:py-32 flex flex-col items-center text-center">
                <div class="inline-flex max-w-full items-center gap-2 px-3 sm:px-4 py-2 rounded-full border border-[#3341FF]/30 bg-[#3341FF]/5 text-[10px] sm:text-xs leading-relaxed tracking-[0.12em] sm:tracking-[0.2em] font-bold text-[#00D2FF] mb-8 uppercase" data-aos="fade-down">
                    <span class="w-2 h-2 shrink-0 rounded-full bg-[#00D2FF] animate-pulse"></span>
                    CUSTOM SOFTWARE ENGINEERING
                </div>

                <h1 class="max-w-full font-heading text-[clamp(2.75rem,14vw,3.75rem)] sm:text-6xl md:text-8xl text-white tracking-normal sm:tracking-wider leading-[0.95] sm:leading-tight mb-8" data-aos="fade-up">
                    CUSTOM<br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#3341FF] to-[#00D2FF]">APPLICATIONS.</span>
                </h1>

                <p class="text-gray-400 font-paragraph text-base sm:text-lg md:text-xl max-w-2xl leading-relaxed mb-10 sm:mb-12" data-aos="fade-up" data-aos-delay="100">
                    We design and build SaaS products, internal tools, customer portals, and custom web applications around real business workflows.
                </p>

                <div class="flex w-full max-w-sm flex-col sm:w-auto sm:max-w-none sm:flex-row gap-4" data-aos="fade-up" data-aos-delay="200">
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-5 sm:px-8 py-4 bg-[#3341FF] hover:bg-[#3341FF]/90 text-white rounded-full font-bold tracking-widest text-xs uppercase transition-all shadow-[0_0_20px_rgba(51,65,255,0.3)] hover:scale-105">
                        Schedule a Discovery Call
                    </a>
                    <a href="#solutions" class="w-full sm:w-auto px-5 sm:px-8 py-4 bg-white/5 hover:bg-white/10 text-white border border-white/10 rounded-full font-bold tracking-widest text-xs uppercase transition-all hover:scale-105">
                        Explore Solutions ↓
                    </a>
                </div>
            </section>

            <!-- CAPABILITIES SECTION -->
            <section class="py-10 sm:py-12 border-y border-white/5 bg-[#111115]/20 backdrop-blur-md rounded-2xl mb-16 sm:mb-24" data-aos="fade-up">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-x-2 gap-y-8 sm:gap-8 text-center">
                    <div class="min-w-0 p-2 sm:p-4 border-r border-white/5 last:border-0">
                        <p class="font-heading text-[clamp(1.25rem,6.5vw,2.25rem)] md:text-2xl lg:text-4xl xl:text-5xl whitespace-nowrap text-[#00D2FF]">SAAS</p>
                        <p class="text-gray-400 text-[10px] sm:text-xs leading-relaxed tracking-wider uppercase font-bold mt-2">Product Development</p>
                    </div>
                    <div class="min-w-0 p-2 sm:p-4 md:border-r border-white/5 last:border-0">
                        <p class="font-heading text-[clamp(1.25rem,6.5vw,2.25rem)] md:text-2xl lg:text-4xl xl:text-5xl whitespace-nowrap text-white">PORTALS</p>
                        <p class="text-gray-400 text-[10px] sm:text-xs leading-relaxed tracking-wider uppercase font-bold mt-2">Customer Experiences</p>
                    </div>
                    <div class="min-w-0 p-2 sm:p-4 border-r border-white/5 last:border-0">
                        <p class="font-heading text-[clamp(1.25rem,6.5vw,2.25rem)] md:text-2xl lg:text-4xl xl:text-5xl whitespace-nowrap text-white">APIS</p>
                        <p class="text-gray-400 text-[10px] sm:text-xs leading-relaxed tracking-wider uppercase font-bold mt-2">Systems Integration</p>
                    </div>
                    <div class="min-w-0 p-2 sm:p-4 last:border-0">
                        <p class="font-heading text-[clamp(1.25rem,6.5vw,2.25rem)] md:text-2xl lg:text-4xl xl:text-5xl whitespace-nowrap text-[#3341FF]">CLOUD</p>
                        <p class="text-gray-400 text-[10px] sm:text-xs leading-relaxed tracking-wider uppercase font-bold mt-2">Deployment & Operations</p>
                    </div>
                </div>
            </section>

            <!-- DETAILED SOLUTIONS -->
            <section id="solutions" class="scroll-mt-24 sm:scroll-mt-32 py-12 sm:py-16 mb-16 sm:mb-24">
                <div class="mb-12 sm:mb-16 text-center md:text-left">
                    <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl text-white mb-4 tracking-wide sm:tracking-wider break-words">WHAT WE BUILD.</h2>
                    <div class="h-[3px] w-20 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] mx-auto md:mx-0"></div>
                </div>

                <div class="grid min-w-0 grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                    {solutions.map((sol, index) => (
                        <div class="group relative min-w-0 rounded-2xl transition-all duration-500 hover:-translate-y-1" data-aos="fade-up" data-aos-delay={index * 50}>
                            <!-- Glow Border -->
                            <div class="absolute -inset-[1px] bg-gradient-to-b from-white/10 to-white/5 rounded-2xl group-hover:from-[#3341FF]/40 group-hover:to-[#00D2FF]/20 transition-all duration-500 z-0"></div>
                            
                            <!-- Inner Content -->
                            <div class="relative z-10 min-w-0 p-5 sm:p-8 rounded-2xl bg-[#111115]/90 backdrop-blur-md h-full flex flex-col justify-between">
                                <div>
                                    <div class="flex min-w-0 items-start sm:items-center justify-between gap-3 sm:gap-6 mb-6">
                                        <h3 class="min-w-0 font-heading text-xl sm:text-2xl md:text-3xl text-white tracking-wide break-words">{sol.title}</h3>
                                        <div class="w-8 h-8 shrink-0 rounded-lg bg-[#3341FF]/10 flex items-center justify-center text-xs font-bold text-[#00D2FF] group-hover:bg-[#3341FF] group-hover:text-white transition-all duration-300">
                                            0{index + 1}
                                        </div>
                                    </div>
                                    <p class="text-gray-400 font-paragraph text-sm leading-relaxed mb-6">
                                        {sol.desc}
                                    </p>
                                </div>
                                <ul class="space-y-3 pt-4 border-t border-white/5">
                                    {sol.features.map(feat => (
                                        <li class="flex min-w-0 items-start sm:items-center gap-3 text-xs text-gray-300">
                                            <svg class="w-4 h-4 text-[#00D2FF] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="min-w-0 break-words font-bold tracking-wide uppercase text-[10px]">{feat}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- API / TECH STACK SECTION -->
            <section class="py-12 sm:py-16 px-5 sm:px-8 md:px-12 mb-16 sm:mb-24 relative rounded-3xl bg-gradient-to-b from-white/[0.02] to-transparent border border-white/5 overflow-hidden" data-aos="fade-up">
                <div class="absolute -right-20 -bottom-20 sm:-right-32 sm:-bottom-32 w-64 h-64 sm:w-96 sm:h-96 bg-[#3341FF]/10 rounded-full blur-[90px] sm:blur-[120px] pointer-events-none"></div>
                <div class="absolute -left-20 -top-20 sm:-left-32 sm:-top-32 w-64 h-64 sm:w-96 sm:h-96 bg-[#00D2FF]/5 rounded-full blur-[90px] sm:blur-[120px] pointer-events-none"></div>

                <div class="grid min-w-0 grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 items-center relative z-10">
                    <div>
                        <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl text-white mb-6 tracking-wide sm:tracking-wider break-words">PRODUCT ENGINEERING STACK.</h2>
                        <p class="text-gray-400 font-paragraph text-sm leading-relaxed mb-8">
                            We choose technologies based on product requirements, team constraints, expected scale, and long-term maintainability.
                        </p>
                        <div class="flex flex-wrap gap-3">
                            {["Ruby on Rails", "React / Next.js", "TypeScript", "Golang", "PostgreSQL", "Redis", "Stripe", "Docker / AWS"].map(tech => (
                                <span class="max-w-full break-words px-3 sm:px-4 py-2 rounded-full bg-white/5 border border-white/10 text-[10px] sm:text-xs font-bold text-gray-300 tracking-wide sm:tracking-wider">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>
                    <div class="min-w-0 max-w-full overflow-x-auto whitespace-nowrap bg-black/40 border border-white/5 rounded-2xl p-4 sm:p-6 md:p-8 font-mono text-[10px] sm:text-xs text-gray-400">
                        <div class="flex items-center gap-2 mb-4 border-b border-white/5 pb-4">
                            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                            <span class="text-[10px] text-gray-500 ml-2">stripe-billing.ts</span>
                        </div>
                        <p class="text-blue-400">import <span class="text-white">Stripe</span> from <span class="text-green-400">"stripe"</span>;</p>
                        <p class="text-blue-400">const <span class="text-purple-400">stripe</span> = <span class="text-white">new</span> <span class="text-[#00D2FF]">Stripe</span>(process.env.STRIPE_SECRET_KEY);</p>
                        <p class="text-gray-500 mt-2">// Create a subscription when the product requires billing</p>
                        <p class="text-[#00D2FF]">export const <span class="text-purple-400">createSubscription</span> = async (customerId, priceId) =&gt; {`{`}</p>
                        <p class="pl-4 text-blue-400">return await stripe.subscriptions.<span class="text-[#00D2FF]">create</span>({`{`}</p>
                        <p class="pl-8 text-white">customer: customerId,</p>
                        <p class="pl-8 text-white">items: [{`{ price: priceId }`}],</p>
                        <p class="pl-8 text-white">payment_behavior: <span class="text-green-400">"default_incomplete"</span>,</p>
                        <p class="pl-4 text-blue-400">{`});`}</p>
                        <p class="text-[#00D2FF]">{`};`}</p>
                        <p class="text-gray-500 mt-2">// Verify signature before processing webhook</p>
                        <p class="text-[#00D2FF]">export const <span class="text-purple-400">handleStripeWebhook</span> = async (req, res) =&gt; {`{`}</p>
                        <p class="pl-4 text-blue-400">const <span class="text-white">event = stripe.webhooks.</span><span class="text-[#00D2FF]">constructEvent</span>(</p>
                        <p class="pl-8 text-white">req.body,</p>
                        <p class="pl-8 text-white">req.headers[<span class="text-green-400">"stripe-signature"</span>],</p>
                        <p class="pl-8 text-white">process.env.STRIPE_WEBHOOK_SECRET,</p>
                        <p class="pl-4 text-white">);</p>
                        <p class="pl-4 text-blue-400">if <span class="text-white">(event.type === </span><span class="text-green-400">"customer.subscription.deleted"</span><span class="text-white">) {`{`}</span></p>
                        <p class="pl-8 text-blue-400">await <span class="text-[#00D2FF]">updateSubscriptionAccess</span>(event.data.object.customer, false);</p>
                        <p class="pl-4 text-white">{`}`}</p>
                        <p class="text-[#00D2FF]">{`};`}</p>
                    </div>
                </div>
            </section>

            <!-- FAQ SECTION -->
            <section class="py-12 sm:py-16 mb-16 sm:mb-24">
                <div class="mb-12 sm:mb-16 text-center">
                    <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl text-white mb-4 tracking-wide sm:tracking-wider break-words">FREQUENTLY ASKED QUESTIONS.</h2>
                    <div class="h-[3px] w-20 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] mx-auto"></div>
                </div>

                <div class="max-w-3xl mx-auto space-y-4">
                    {faqItems.map((item) => (
                        <details class="group relative rounded-xl border border-white/5 bg-[#111115]/30 overflow-hidden transition-all duration-300 [&_summary::-webkit-details-marker]:hidden" data-aos="fade-up">
                            <summary class="flex min-w-0 justify-between items-center gap-3 p-5 sm:p-6 cursor-pointer select-none">
                                <h3 class="min-w-0 break-words font-heading text-base sm:text-lg md:text-xl text-white tracking-wide sm:tracking-wider pr-1 sm:pr-4 group-hover:text-[#00D2FF] transition-colors">{item.q}</h3>
                                <div class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 group-open:rotate-180 transition-transform duration-300">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </summary>
                            <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-2 border-t border-white/5 text-gray-400 font-paragraph text-sm leading-relaxed">
                                <p>{item.a}</p>
                            </div>
                        </details>
                    ))}
                </div>
            </section>

            <!-- CALL TO ACTION -->
            <section class="py-12 sm:py-20 text-center relative overflow-hidden rounded-3xl bg-gradient-to-b from-[#3341FF]/10 to-[#3341FF]/2 border border-[#3341FF]/20 px-4 sm:px-6 mb-16 sm:mb-24" data-aos="fade-up">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(51,65,255,0.15),transparent)] pointer-events-none"></div>
                <div class="relative z-10 max-w-2xl mx-auto">
                    <h2 class="max-w-full break-words font-heading text-[clamp(2.5rem,12vw,3rem)] md:text-7xl leading-tight text-white mb-6">LET'S BUILD YOUR PRODUCT.</h2>
                    <p class="text-gray-300 font-paragraph text-sm md:text-base leading-relaxed mb-10">
                        Have a SaaS product, internal tool, customer portal, or custom application to build? Let's discuss the product and technical requirements.
                    </p>
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="inline-block w-full sm:w-auto px-5 sm:px-10 py-5 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] hover:opacity-90 text-white rounded-full font-bold tracking-widest text-xs uppercase transition-all shadow-[0_0_30px_rgba(51,65,255,0.4)] hover:scale-105">
                        Schedule a Discovery Call
                    </a>
                </div>
            </section>

        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* Details tag transition enhancements */
    details[open] summary ~ * {
        animation: slideDown 0.3s ease-out-expo;
    }
    
    @keyframes slideDown {
        0% {
            opacity: 0;
            transform: translateY(-8px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
