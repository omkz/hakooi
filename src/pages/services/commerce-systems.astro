---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// SEO details
const title = "Commerce Systems Engineering | Hakooi | Commerce Engineering Studio";
const desc = "We build scalable backend systems, custom order management (OMS), product information management (PIM), and secure ERP integrations for multi-channel commerce operations.";

const solutions = [
    {
        title: "Order & Inventory Sync (OMS)",
        desc: "Automate synchronization across Shopify, multiple marketplaces, and offline POS systems. We build event-driven engines that manage stock allocations, dynamic reservations, and split-routing logistics in real-time.",
        features: ["Multi-channel inventory mapping", "Automated split-shipment rules", "Real-time stock ledger tracking", "Custom warehouse API integration"]
    },
    {
        title: "Product Information Management (PIM)",
        desc: "Establish a single source of truth for global product data. Our custom PIM architectures centralize SKU information, assets, localized translation workflows, and multi-tier pricing structures.",
        features: ["Bulk catalog schema editors", "Localization & translation pipelines", "Automated syndication feeds", "High-fidelity digital asset handling"]
    },
    {
        title: "Custom Dashboards & Internal Tools",
        desc: "Stop running your business on generic spreadsheets. We design high-fidelity administrative panels, customer support consoles, and shipping queues perfectly tailored to your warehouse operation teams.",
        features: ["Role-based access control (RBAC)", "Real-time transactional reporting", "Custom bulk import/export utilities", "Instant log audit trails"]
    },
    {
        title: "Middleware & Serverless Pipelines",
        desc: "Secure, highly-resilient API integration layers. We build modern middleware to bridge modern storefronts with legacy enterprise ERPs, featuring automatic queue retries and robust error handling.",
        features: ["SAP, NetSuite, & Dynamics bridges", "Event queueing (RabbitMQ / SQS)", "Serverless auto-scaling compute", "Zero-data-loss transaction logging"]
    }
];

const faqItems = [
    {
        q: "Why do we need a custom Commerce System instead of just using standard Shopify apps?",
        a: "While Shopify apps are great for basic needs, they run on shared infrastructure, are limited by Shopify's API rate limits, and fragment your business data across dozens of third-party servers. A custom Commerce System built by Hakooi centralizes your business logic and data. It allows you to run complex inventory allocation algorithms, handle massive transaction volumes without rate limiting, and interface securely with legacy enterprise software under your own infrastructure."
    },
    {
        q: "What database and server architectures do you use for these engines?",
        a: "We architect systems focusing on absolute data integrity and sub-second performance. We utilize PostgreSQL with strict schemas for transactional accounting, Redis for hyper-fast state caching, and Node.js or Go for execution runtime. The infrastructure is hosted on serverless clouds (like AWS or Vercel) which automatically scale up during traffic spikes (e.g., Black Friday) and scale down to zero when idle to minimize operational costs."
    },
    {
        q: "Can you integrate older, legacy ERP systems like Microsoft Dynamics or SAP?",
        a: "Absolutely. We specialize in building secure, resilient middleware bridges. Since legacy ERPs often lack webhook support or modern REST architectures, we build custom sync daemons or serverless polling pipelines that translate modern webhook events from your storefront into secure, batch-processed files or XML/SOAP payloads accepted by your legacy corporate ERP, complete with robust failure alerts."
    },
    {
        q: "How do your systems handle high-concurrency flash sales events?",
        a: "We prevent database crashes by separating the ingestion layer from the writing layer using asynchronous messaging queues (like AWS SQS or RabbitMQ). If 10,000 customers place an order in the same second, the storefront quickly acknowledges the request, places it into a highly scalable queue, and background workers process the orders at a safe, continuous rate, protecting your backend ERP from collapsing under sudden load."
    }
];

// JSON-LD Schema for SEO rich snippets
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
        }
    }))
};
---

<Layout title={title}>
    <!-- FAQ Schema Injection -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <Navbar />

    <main class="relative overflow-hidden pt-28">
        <!-- Grid/Dot Background -->
        <div class="fixed inset-0 z-0 pointer-events-none opacity-20">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
            <div class="absolute top-0 left-0 w-full h-[500px] bg-gradient-to-b from-[#3341FF]/20 to-transparent blur-[120px]"></div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto px-6">
            
            <!-- HERO SECTION -->
            <section class="py-20 md:py-32 flex flex-col items-center text-center">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#3341FF]/30 bg-[#3341FF]/5 text-xs tracking-[0.2em] font-bold text-[#00D2FF] mb-8 uppercase" data-aos="fade-down">
                    <span class="w-2 h-2 rounded-full bg-[#00D2FF] animate-pulse"></span>
                    Enterprise System Architecture
                </div>

                <h1 class="font-heading text-6xl md:text-8xl text-white tracking-wider max-w-4xl leading-tight mb-8" data-aos="fade-up">
                    COMMERCE<br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#3341FF] to-[#00D2FF]">SYSTEMS.</span>
                </h1>

                <p class="text-gray-400 font-paragraph text-lg md:text-xl max-w-2xl leading-relaxed mb-12" data-aos="fade-up" data-aos-delay="100">
                    We design and engineer high-concurrency order management engines, centralized PIM systems, custom admin dashboards, and bulletproof middleware connecting modern storefronts to legacy enterprise ERPs.
                </p>

                <div class="flex flex-col sm:flex-row gap-4" data-aos="fade-up" data-aos-delay="200">
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-[#3341FF] hover:bg-[#3341FF]/90 text-white rounded-full font-bold tracking-widest text-xs uppercase transition-all shadow-[0_0_20px_rgba(51,65,255,0.3)] hover:scale-105">
                        Schedule a Discovery Call
                    </a>
                    <a href="#solutions" class="px-8 py-4 bg-white/5 hover:bg-white/10 text-white border border-white/10 rounded-full font-bold tracking-widest text-xs uppercase transition-all hover:scale-105">
                        Explore Infrastructure ↓
                    </a>
                </div>
            </section>

            <!-- STATS SECTION -->
            <section class="py-12 border-y border-white/5 bg-[#111115]/20 backdrop-blur-md rounded-2xl mb-24" data-aos="fade-up">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    <div class="p-4 border-r border-white/5 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-[#00D2FF]">&lt; 200MS</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">API Response Time</p>
                    </div>
                    <div class="p-4 md:border-r border-white/5 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-white">99.99%</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Guaranteed Uptime</p>
                    </div>
                    <div class="p-4 border-r border-white/5 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-white">100%</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Automated Sync</p>
                    </div>
                    <div class="p-4 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-[#3341FF]">0%</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Lag Data Pipelines</p>
                    </div>
                </div>
            </section>

            <!-- DETAILED SOLUTIONS -->
            <section id="solutions" class="py-16 mb-24">
                <div class="mb-16 text-center md:text-left">
                    <h2 class="font-heading text-4xl md:text-5xl text-white mb-4 tracking-wider">BULLETPROOF INFRASTRUCTURE.</h2>
                    <div class="h-[3px] w-20 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] mx-auto md:mx-0"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {solutions.map((sol, index) => (
                        <div class="group relative rounded-2xl transition-all duration-500 hover:-translate-y-1" data-aos="fade-up" data-aos-delay={index * 50}>
                            <!-- Glow Border -->
                            <div class="absolute -inset-[1px] bg-gradient-to-b from-white/10 to-white/5 rounded-2xl group-hover:from-[#3341FF]/40 group-hover:to-[#00D2FF]/20 transition-all duration-500 z-0"></div>
                            
                            <!-- Inner Content -->
                            <div class="relative z-10 p-8 rounded-2xl bg-[#111115]/90 backdrop-blur-md h-full flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-6">
                                        <h3 class="font-heading text-2xl md:text-3xl text-white tracking-wide">{sol.title}</h3>
                                        <div class="w-8 h-8 rounded-lg bg-[#3341FF]/10 flex items-center justify-center text-xs font-bold text-[#00D2FF] group-hover:bg-[#3341FF] group-hover:text-white transition-all duration-300">
                                            0{index + 1}
                                        </div>
                                    </div>
                                    <p class="text-gray-400 font-paragraph text-sm leading-relaxed mb-6">
                                        {sol.desc}
                                    </p>
                                </div>
                                <ul class="space-y-3 pt-4 border-t border-white/5">
                                    {sol.features.map(feat => (
                                        <li class="flex items-center gap-3 text-xs text-gray-300">
                                            <svg class="w-4 h-4 text-[#00D2FF] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="font-bold tracking-wide uppercase text-[10px]">{feat}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- ARCHITECTURE DIAGRAM / TECH STACK -->
            <section class="py-16 mb-24 relative rounded-3xl bg-gradient-to-b from-white/[0.02] to-transparent border border-white/5 p-8 md:p-12 overflow-hidden" data-aos="fade-up">
                <div class="absolute -right-32 -bottom-32 w-96 h-96 bg-[#3341FF]/10 rounded-full blur-[120px] pointer-events-none"></div>
                <div class="absolute -left-32 -top-32 w-96 h-96 bg-[#00D2FF]/5 rounded-full blur-[120px] pointer-events-none"></div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
                    <div>
                        <h2 class="font-heading text-4xl md:text-5xl text-white mb-6 tracking-wider">ENGINEERING STACK.</h2>
                        <p class="text-gray-400 font-paragraph text-sm leading-relaxed mb-8">
                            We build on cloud-native databases, event-driven message queues, and bulletproof relational structures to guarantee zero-data-loss and absolute consistency.
                        </p>
                        <div class="flex flex-wrap gap-3">
                            {["PostgreSQL", "Node.js (TypeScript)", "GraphQL / REST APIs", "Redis Cache", "RabbitMQ / SQS", "Docker Containers", "Prisma ORM", "AWS Cloud / VPC"].map(tech => (
                                <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-xs font-bold text-gray-300 tracking-wider">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>
                    <div class="bg-black/40 border border-white/5 rounded-2xl p-6 md:p-8 font-mono text-xs text-gray-400">
                        <div class="flex items-center gap-2 mb-4 border-b border-white/5 pb-4">
                            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                            <span class="text-[10px] text-gray-500 ml-2">schema.prisma</span>
                        </div>
                        <p class="text-blue-400">model <span class="text-white">Order</span> {`{`}</p>
                        <p class="pl-4 text-white">id&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;String&nbsp;&nbsp;&nbsp;@id @default(uuid())</p>
                        <p class="pl-4 text-white">orderNumber&nbsp;String&nbsp;&nbsp;&nbsp;@unique</p>
                        <p class="pl-4 text-white">status&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;String&nbsp;&nbsp;&nbsp;// PENDING, SYNCED, FAILED</p>
                        <p class="pl-4 text-white">totalAmount&nbsp;Decimal&nbsp;&nbsp;@db.Decimal(10, 2)</p>
                        <p class="pl-4 text-white">items&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;OrderItem[]</p>
                        <p class="pl-4 text-white">createdAt&nbsp;&nbsp;&nbsp;DateTime&nbsp;@default(now())</p>
                        <p class="text-blue-400">{`}`}</p>
                        <br/>
                        <p class="text-blue-400">model <span class="text-white">InventoryItem</span> {`{`}</p>
                        <p class="pl-4 text-white">id&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;String&nbsp;&nbsp;&nbsp;@id @default(uuid())</p>
                        <p class="pl-4 text-white">sku&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;String&nbsp;&nbsp;&nbsp;@unique</p>
                        <p class="pl-4 text-white">available&nbsp;&nbsp;&nbsp;Int</p>
                        <p class="pl-4 text-white">reserved&nbsp;&nbsp;&nbsp;&nbsp;Int&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@default(0)</p>
                        <p class="pl-4 text-white">updatedAt&nbsp;&nbsp;&nbsp;DateTime&nbsp;@updatedAt</p>
                        <p class="text-blue-400">{`}`}</p>
                    </div>
                </div>
            </section>

            <!-- FAQ SECTION -->
            <section class="py-16 mb-24">
                <div class="mb-16 text-center">
                    <h2 class="font-heading text-4xl md:text-5xl text-white mb-4 tracking-wider">FREQUENTLY ASKED QUESTIONS.</h2>
                    <div class="h-[3px] w-20 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] mx-auto"></div>
                </div>

                <div class="max-w-3xl mx-auto space-y-4">
                    {faqItems.map((item, index) => (
                        <details class="group relative rounded-xl border border-white/5 bg-[#111115]/30 overflow-hidden transition-all duration-300 [&_summary::-webkit-details-marker]:hidden" data-aos="fade-up">
                            <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
                                <h3 class="font-heading text-lg md:text-xl text-white tracking-wider pr-4 group-hover:text-[#00D2FF] transition-colors">{item.q}</h3>
                                <div class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 group-open:rotate-180 transition-transform duration-300">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </summary>
                            <div class="px-6 pb-6 pt-2 border-t border-white/5 text-gray-400 font-paragraph text-sm leading-relaxed">
                                <p>{item.a}</p>
                            </div>
                        </details>
                    ))}
                </div>
            </section>

            <!-- CALL TO ACTION -->
            <section class="py-20 text-center relative overflow-hidden rounded-3xl bg-gradient-to-b from-[#3341FF]/10 to-[#3341FF]/2 border border-[#3341FF]/20 px-6 mb-24" data-aos="fade-up">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(51,65,255,0.15),transparent)] pointer-events-none"></div>
                <div class="relative z-10 max-w-2xl mx-auto">
                    <h2 class="font-heading text-5xl md:text-7xl text-white mb-6">UNIFY YOUR COMMERCE OPERATIONS.</h2>
                    <p class="text-gray-300 font-paragraph text-sm md:text-base leading-relaxed mb-10">
                        Let's architectural-design a robust transactional backend tailored to your company's logistics, inventory channels, and high-concurrency events.
                    </p>
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="inline-block px-10 py-5 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] hover:opacity-90 text-white rounded-full font-bold tracking-widest text-xs uppercase transition-all shadow-[0_0_30px_rgba(51,65,255,0.4)] hover:scale-105">
                        Schedule an Architecture Call
                    </a>
                </div>
            </section>

        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* Details tag transition enhancements */
    details[open] summary ~ * {
        animation: slideDown 0.3s ease-out-expo;
    }
    
    @keyframes slideDown {
        0% {
            opacity: 0;
            transform: translateY(-8px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
