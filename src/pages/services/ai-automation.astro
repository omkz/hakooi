---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ServiceBreadcrumbs from '../../components/ServiceBreadcrumbs.astro';

// SEO details
const title = "AI & Intelligent Business Automation | Hakooi | Commerce Engineering Studio";
const desc = "We engineer custom LLM integrations, event-driven background workflow automations, intelligent document parsing, and automated vector search systems.";

const solutions = [
    {
        title: "Custom LLM & Agentic Systems",
        desc: "Supercharge your business with custom-tailored LLM pipelines. We build intelligent agentic systems using OpenAI and Anthropic models, custom-curated with your company knowledge bases using Vector DBs.",
        features: ["Retrieval-Augmented Generation (RAG)", "Autonomous backend agentic workflows", "Custom vector embedding pipelines", "Semantic search implementation"]
    },
    {
        title: "Event-Driven Workflow Automation",
        desc: "Eliminate repetitive manual data entry. We write robust backend triggers that connect your storefronts, CRMs, shipping carriers, and chat tools (Slack/Teams) into lightning-fast serverless pipelines.",
        features: ["Real-time webhook routing layers", "Automated email/SMS notification flows", "Automatic error-logging reporting", "Multi-system background syncs"]
    },
    {
        title: "Intelligent Document Parsing (OCR)",
        desc: "Transform messy paper trails into clean structured database assets. We write intelligent document pipelines to automatically extract data from invoices, packing slips, PDFs, and vendor catalog feeds.",
        features: ["Structured JSON output mapping", "Advanced AI-powered OCR engines", "Automated double-entry verification", "Real-time ledger updates"]
    },
    {
        title: "Smart AI Customer Support",
        desc: "Deploy highly-secure, context-aware AI support systems. Our custom support pipelines resolve up to 70% of customer questions, track order shipments, and assist with return flows with absolute safety.",
        features: ["Strict systemic guardrail filters", "Real-time Shopify API actions", "Intelligent human-handoff rules", "Multi-language support ready"]
    }
];

const faqItems = [
    {
        q: "How do you prevent the AI from 'hallucinating' or giving incorrect answers to our customers?",
        a: "We implement Retrieval-Augmented Generation (RAG) combined with strict systemic guardrails. Rather than letting the model answer freely from its general public training, we force the AI to first query a private Vector Database containing only your official policies and catalog details. The AI is structurally constrained to ONLY answer using the facts retrieved from your database, and if the info isn't found, it gracefully routes the conversation to a human support agent."
    },
    {
        q: "Can you automate workflows inside our existing Shopify or custom commerce backend?",
        a: "Yes. We write serverless automation scripts that trigger on standard commerce webhooks (e.g. order paid, inventory low). We can build workflows that automatically tag and categorize newly imported products, flag high-risk fraud orders based on historical data patterns, or automatically draft and queue personalized marketing emails for VIP shoppers."
    },
    {
        q: "What vector databases and embedding models do you use?",
        a: "We choose robust, industry-standard solutions. For database vectors, we use PGVector (extending our PostgreSQL schemas) or dedicated managed vector stores like Pinecone for rapid semantic lookup. We generate semantic text embeddings using OpenAI's `text-embedding-3-small` or Cohere's multilingual embedding models, guaranteeing high semantic matching accuracy in less than 50 milliseconds."
    },
    {
        q: "Is our proprietary company and customer data secure when using LLMs?",
        a: "Absolutely. We route all queries through enterprise-grade API endpoints that explicitly guarantee in their terms of service that your inputs, documents, and customer prompts will **never** be stored or used to train public foundational LLM models. All vector databases are hosted in isolated virtual private clouds (VPCs) under strict end-to-end data encryption."
    }
];

// JSON-LD Schema for SEO rich snippets
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
        }
    }))
};
---

<Layout title={title} description={desc}>
    <!-- FAQ Schema Injection -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <ServiceBreadcrumbs currentPage="AI & Intelligent Business Automation" />

    <Navbar />

    <main class="relative overflow-hidden pt-28">
        <!-- Grid/Dot Background -->
        <div class="fixed inset-0 z-0 pointer-events-none opacity-20">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
            <div class="absolute top-0 left-0 w-full h-[500px] bg-gradient-to-b from-[#3341FF]/20 to-transparent blur-[120px]"></div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto px-6">
            
            <!-- HERO SECTION -->
            <section class="py-20 md:py-32 flex flex-col items-center text-center">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#3341FF]/30 bg-[#3341FF]/5 text-xs tracking-[0.2em] font-bold text-[#00D2FF] mb-8 uppercase" data-aos="fade-down">
                    <span class="w-2 h-2 rounded-full bg-[#00D2FF] animate-pulse"></span>
                    Cognitive Workflow Automation
                </div>

                <h1 class="font-heading text-6xl md:text-8xl text-white tracking-wider max-w-4xl leading-tight mb-8" data-aos="fade-up">
                    AI & BUSINESS<br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#3341FF] to-[#00D2FF]">AUTOMATION.</span>
                </h1>

                <p class="text-gray-400 font-paragraph text-lg md:text-xl max-w-2xl leading-relaxed mb-12" data-aos="fade-up" data-aos-delay="100">
                    We build context-aware AI agents, custom vector-embedded RAG pipelines, intelligent document parsers, and event-driven automation frameworks that save thousands of operational hours.
                </p>

                <div class="flex flex-col sm:flex-row gap-4" data-aos="fade-up" data-aos-delay="200">
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-[#3341FF] hover:bg-[#3341FF]/90 text-white rounded-full font-bold tracking-widest text-xs uppercase transition-all shadow-[0_0_20px_rgba(51,65,255,0.3)] hover:scale-105">
                        Schedule a Discovery Call
                    </a>
                    <a href="#solutions" class="px-8 py-4 bg-white/5 hover:bg-white/10 text-white border border-white/10 rounded-full font-bold tracking-widest text-xs uppercase transition-all hover:scale-105">
                        Explore Cognitive Workflows ↓
                    </a>
                </div>
            </section>

            <!-- STATS SECTION -->
            <section class="py-12 border-y border-white/5 bg-[#111115]/20 backdrop-blur-md rounded-2xl mb-24" data-aos="fade-up">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    <div class="p-4 border-r border-white/5 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-[#00D2FF]">500+</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Hours Saved / Mo</p>
                    </div>
                    <div class="p-4 md:border-r border-white/5 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-white">99.2%</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Parsing Accuracy</p>
                    </div>
                    <div class="p-4 border-r border-white/5 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-white">&lt; 1.5S</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Processing Time</p>
                    </div>
                    <div class="p-4 last:border-0">
                        <p class="font-heading text-4xl md:text-5xl text-[#3341FF]">-70%</p>
                        <p class="text-gray-400 text-xs tracking-wider uppercase font-bold mt-2">Support Overhead</p>
                    </div>
                </div>
            </section>

            <!-- DETAILED SOLUTIONS -->
            <section id="solutions" class="py-16 mb-24">
                <div class="mb-16 text-center md:text-left">
                    <h2 class="font-heading text-4xl md:text-5xl text-white mb-4 tracking-wider">COGNITIVE SOLUTIONS.</h2>
                    <div class="h-[3px] w-20 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] mx-auto md:mx-0"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {solutions.map((sol, index) => (
                        <div class="group relative rounded-2xl transition-all duration-500 hover:-translate-y-1" data-aos="fade-up" data-aos-delay={index * 50}>
                            <!-- Glow Border -->
                            <div class="absolute -inset-[1px] bg-gradient-to-b from-white/10 to-white/5 rounded-2xl group-hover:from-[#3341FF]/40 group-hover:to-[#00D2FF]/20 transition-all duration-500 z-0"></div>
                            
                            <!-- Inner Content -->
                            <div class="relative z-10 p-8 rounded-2xl bg-[#111115]/90 backdrop-blur-md h-full flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-6">
                                        <h3 class="font-heading text-2xl md:text-3xl text-white tracking-wide">{sol.title}</h3>
                                        <div class="w-8 h-8 rounded-lg bg-[#3341FF]/10 flex items-center justify-center text-xs font-bold text-[#00D2FF] group-hover:bg-[#3341FF] group-hover:text-white transition-all duration-300">
                                            0{index + 1}
                                        </div>
                                    </div>
                                    <p class="text-gray-400 font-paragraph text-sm leading-relaxed mb-6">
                                        {sol.desc}
                                    </p>
                                </div>
                                <ul class="space-y-3 pt-4 border-t border-white/5">
                                    {sol.features.map(feat => (
                                        <li class="flex items-center gap-3 text-xs text-gray-300">
                                            <svg class="w-4 h-4 text-[#00D2FF] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="font-bold tracking-wide uppercase text-[10px]">{feat}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- API / TECH STACK SECTION -->
            <section class="py-16 mb-24 relative rounded-3xl bg-gradient-to-b from-white/[0.02] to-transparent border border-white/5 p-8 md:p-12 overflow-hidden" data-aos="fade-up">
                <div class="absolute -right-32 -bottom-32 w-96 h-96 bg-[#3341FF]/10 rounded-full blur-[120px] pointer-events-none"></div>
                <div class="absolute -left-32 -top-32 w-96 h-96 bg-[#00D2FF]/5 rounded-full blur-[120px] pointer-events-none"></div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
                    <div>
                        <h2 class="font-heading text-4xl md:text-5xl text-white mb-6 tracking-wider">AI TECH STACK.</h2>
                        <p class="text-gray-400 font-paragraph text-sm leading-relaxed mb-8">
                            We don't build generic wrappers. We write custom API routes, optimize embedding queues, and secure vector databases using modern, reliable technologies.
                        </p>
                        <div class="flex flex-wrap gap-3">
                            {["OpenAI & Anthropic APIs", "Vector DBs (Pinecone / PGVector)", "Python / TypeScript", "Golang", "Cloudflare Workers", "AWS Lambda / SQS", "Docker Containers", "PostgreSQL + PGVector"].map(tech => (
                                <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-xs font-bold text-gray-300 tracking-wider">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>
                    <div class="bg-black/40 border border-white/5 rounded-2xl p-6 md:p-8 font-mono text-xs text-gray-400">
                        <div class="flex items-center gap-2 mb-4 border-b border-white/5 pb-4">
                            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                            <span class="text-[10px] text-gray-500 ml-2">rag-query.py</span>
                        </div>
                        <p class="text-[#00D2FF]">from <span class="text-white">openai</span> import <span class="text-[#00D2FF]">OpenAI</span></p>
                        <p class="text-[#00D2FF]">from <span class="text-white">pinecone</span> import <span class="text-[#00D2FF]">Pinecone</span></p>
                        <p class="text-white mt-2">ai = OpenAI()&nbsp;&nbsp;pc = Pinecone()</p>
                        <p class="text-white">index = pc.Index(<span class="text-green-400">"commerce-kb"</span>)</p>
                        <br/>
                        <p class="text-[#00D2FF]">def <span class="text-[#00D2FF]">rag_answer</span>(user_prompt: <span class="text-[#00D2FF]">str</span>) -&gt; <span class="text-[#00D2FF]">str</span>:</p>
                        <p class="pl-4 text-gray-500"># embed query, retrieve context</p>
                        <p class="pl-4 text-white">embed = ai.embeddings.create(</p>
                        <p class="pl-8 text-white">input=user_prompt, model=<span class="text-green-400">"text-embedding-3-small"</span></p>
                        <p class="pl-4 text-white">).data[0].embedding</p>
                        <p class="pl-4 text-white">hits = index.query(vector=embed, top_k=<span class="text-yellow-400">3</span>, include_metadata=<span class="text-[#00D2FF]">True</span>)</p>
                        <p class="pl-4 text-white">ctx = <span class="text-green-400">"\n"</span>.join(h.metadata[<span class="text-green-400">"text"</span>] <span class="text-[#00D2FF]">for</span> h <span class="text-[#00D2FF]">in</span> hits.matches)</p>
                        <br/>
                        <p class="pl-4 text-gray-500"># ground the answer in retrieved context</p>
                        <p class="pl-4 text-blue-400">return <span class="text-white">ai.chat.completions.create(</span></p>
                        <p class="pl-8 text-white">model=<span class="text-green-400">"gpt-4o-mini"</span>,</p>
                        <p class="pl-8 text-white">messages=[</p>
                        <p class="pl-12 text-white">{`{"role":"system","content":f"Answer using: {ctx}"}`},</p>
                        <p class="pl-12 text-white">{`{"role":"user",  "content": user_prompt}`},</p>
                        <p class="pl-8 text-white">],</p>
                        <p class="pl-4 text-white">).choices[<span class="text-yellow-400">0</span>].message.content</p>
                    </div>
                </div>
            </section>

            <!-- FAQ SECTION -->
            <section class="py-16 mb-24">
                <div class="mb-16 text-center">
                    <h2 class="font-heading text-4xl md:text-5xl text-white mb-4 tracking-wider">FREQUENTLY ASKED QUESTIONS.</h2>
                    <div class="h-[3px] w-20 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] mx-auto"></div>
                </div>

                <div class="max-w-3xl mx-auto space-y-4">
                    {faqItems.map((item) => (
                        <details class="group relative rounded-xl border border-white/5 bg-[#111115]/30 overflow-hidden transition-all duration-300 [&_summary::-webkit-details-marker]:hidden" data-aos="fade-up">
                            <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
                                <h3 class="font-heading text-lg md:text-xl text-white tracking-wider pr-4 group-hover:text-[#00D2FF] transition-colors">{item.q}</h3>
                                <div class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 group-open:rotate-180 transition-transform duration-300">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </summary>
                            <div class="px-6 pb-6 pt-2 border-t border-white/5 text-gray-400 font-paragraph text-sm leading-relaxed">
                                <p>{item.a}</p>
                            </div>
                        </details>
                    ))}
                </div>
            </section>

            <!-- CALL TO ACTION -->
            <section class="py-20 text-center relative overflow-hidden rounded-3xl bg-gradient-to-b from-[#3341FF]/10 to-[#3341FF]/2 border border-[#3341FF]/20 px-6 mb-24" data-aos="fade-up">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(51,65,255,0.15),transparent)] pointer-events-none"></div>
                <div class="relative z-10 max-w-2xl mx-auto">
                    <h2 class="font-heading text-5xl md:text-7xl text-white mb-6">INTELLECTUALIZE YOUR OPERATIONS.</h2>
                    <p class="text-gray-300 font-paragraph text-sm md:text-base leading-relaxed mb-10">
                        Let's consult on how context-aware AI agents, serverless data extraction pipelines, and automated integrations can optimize your workflow.
                    </p>
                    <a href="https://calendly.com/hakooi" target="_blank" rel="noopener noreferrer" class="inline-block px-10 py-5 bg-gradient-to-r from-[#3341FF] to-[#00D2FF] hover:opacity-90 text-white rounded-full font-bold tracking-widest text-xs uppercase transition-all shadow-[0_0_30px_rgba(51,65,255,0.4)] hover:scale-105">
                        Schedule a Discovery Call
                    </a>
                </div>
            </section>

        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* Details tag transition enhancements */
    details[open] summary ~ * {
        animation: slideDown 0.3s ease-out-expo;
    }
    
    @keyframes slideDown {
        0% {
            opacity: 0;
            transform: translateY(-8px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
