---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Team from '../components/Team.astro';
import TechStack from '../components/TechStack.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Hakooi | Product Engineering Studio"
	description="Hakooi is a product engineering studio building software products, commerce systems, and applied AI — from idea to production."
>
	<Navbar />
	<main class="relative overflow-hidden">
		<!-- Decorative Background Elements -->
		<div class="fixed inset-0 z-0 pointer-events-none">
			<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-blue-600/10 rounded-full blur-[120px]"></div>
			<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-indigo-600/10 rounded-full blur-[120px]"></div>
		</div>

		<div class="relative z-10">
			<div data-aos="fade-in"><Hero /></div>
			<div data-aos="fade-up"><Services /></div>
			<div data-aos="fade-up"><Process /></div>
			<div data-aos="fade-up"><Team /></div>
			<div data-aos="fade-up"><TechStack /></div>
			<Footer />
		</div>
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
	}
</style>
